generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BotResponseMode {
  KEYWORDS
  AI
  HYBRID
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum AiProvider {
  CLAUDE
  OPENAI
  GEMINI
}

enum ChannelProvider {
  DIALOG360
  EVOLUTION
  BAILEYS
}

enum VariableType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

enum ConversationStatus {
  BOT
  WAITING
  HUMAN
  CLOSED
}

enum MessageSender {
  CONTACT
  BOT
  HUMAN
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  plan             SubscriptionPlan @default(FREE)
  loginToken       String?
  loginTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bots      Bot[]
  aiConfigs AiConfig[]

  @@map("users")
}

model AiConfig {
  id          String     @id @default(uuid())
  userId      String
  provider    AiProvider
  name        String     // Nome amigável (ex: "Meu Claude", "GPT-4o")
  apiKey      String     // API key do provedor
  model       String     // ID do modelo (ex: "claude-sonnet-4-20250514", "gpt-4o", "gemini-2.0-flash")
  maxTokens   Int        @default(1024)
  temperature Float      @default(0.7)
  isDefault   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bots Bot[]

  @@map("ai_configs")
}

model Bot {
  id           String          @id @default(uuid())
  userId       String
  name         String
  initialMessage String?       @db.Text
  responseMode BotResponseMode @default(KEYWORDS)
  isActive     Boolean         @default(true)
  systemPrompt String?         @db.Text // Prompt de sistema para IA
  aiConfigId   String?
  flowConfig   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiConfig        AiConfig?        @relation(fields: [aiConfigId], references: [id], onDelete: SetNull)
  whatsappChannel WhatsappChannel?
  keywords        Keyword[]
  conversations   Conversation[]
  menus           InteractiveMenu[]

  @@map("bots")
}

model InteractiveMenu {
  id              String   @id @default(uuid())
  botId           String
  trigger         String   // Keyword or command that activates this menu
  title           String   // Menu title/header
  body            String?  @db.Text // Menu body text
  footer          String?  // Menu footer text
  options         Json     // Array of { id: string, title: string, description?: string }
  captureVariable Json?    // { name: string, type: VariableType, promptMessage: string } - captura de variável
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, trigger])
  @@map("interactive_menus")
}

model WhatsappChannel {
  id              String          @id @default(uuid())
  botId           String          @unique
  phoneNumber     String          @unique
  provider        ChannelProvider @default(DIALOG360)
  dialog360ApiKey String?
  // Evolution API fields
  evolutionApiUrl    String?      // URL da instância Evolution (ex: https://api.evolution.com)
  evolutionApiKey    String?      // Global API Key da Evolution
  evolutionInstance  String?      // Nome da instância na Evolution
  // Baileys fields
  baileysSessionId   String?      // ID da sessão Baileys (para persistência)
  webhookSecret   String?
  isVerified      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("whatsapp_channels")
}

model Keyword {
  id              String   @id @default(uuid())
  botId           String
  trigger         String   // Palavra/frase que ativa a resposta
  response        String   @db.Text // Resposta fixa
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  goto            Json?    // { type: 'MENU' | 'KEYWORD', target: string } - navegação após resposta
  captureVariable Json?    // { name: string, type: VariableType, promptMessage: string } - captura de variável
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, trigger])
  @@map("keywords")
}

model Conversation {
  id                    String   @id @default(uuid())
  botId                 String
  contactPhone          String
  contactName           String?
  isActive              Boolean  @default(true)
  status                ConversationStatus @default(BOT)
  humanTakeoverAt       DateTime?
  lastMessageAt         DateTime @default(now())
  flowStepIndex         Int      @default(0)
  waitingForVariable    Boolean  @default(false)
  pendingVariableName   String?
  pendingVariableType   VariableType?
  pendingVariableGoto   Json?    // goto a executar após captura da variável
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bot       Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages  Message[]
  variables ConversationVariable[]

  @@unique([botId, contactPhone])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationVariable {
  id             String       @id @default(uuid())
  conversationId String
  name           String
  type           VariableType
  value          String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, name])
  @@map("conversation_variables")
}

model Message {
  id              String           @id @default(uuid())
  conversationId  String
  direction       MessageDirection
  content         String           @db.Text
  status          MessageStatus    @default(SENT)
  senderType      MessageSender    @default(BOT)
  dialog360MsgId  String?
  externalMsgId   String?          // ID genérico da mensagem (Evolution ou outro provider)
  createdAt       DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
