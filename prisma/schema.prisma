generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BotResponseMode {
  KEYWORDS
  AI
  HYBRID
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum AiProvider {
  CLAUDE
  OPENAI
  GEMINI
}

enum ChannelProvider {
  DIALOG360
  EVOLUTION
  BAILEYS
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum BroadcastStatus {
  DRAFT
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum VariableType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

enum ConversationStatus {
  BOT
  WAITING
  HUMAN
  CLOSED
}

enum MessageSender {
  CONTACT
  BOT
  HUMAN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum IterationType {
  TEXT
  LINK
  DOCUMENT
  GOTO
  CAPTURE_VARIABLE
  CLOSE_CONVERSATION
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  plan             SubscriptionPlan @default(FREE)
  loginToken       String?
  loginTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bots      Bot[]
  aiConfigs AiConfig[]

  @@map("users")
}

model AiConfig {
  id          String     @id @default(uuid())
  userId      String
  provider    AiProvider
  name        String     // Nome amigável (ex: "Meu Claude", "GPT-4o")
  apiKey      String     // API key do provedor
  model       String     // ID do modelo (ex: "claude-sonnet-4-20250514", "gpt-4o", "gemini-2.0-flash")
  maxTokens   Int        @default(1024)
  temperature Float      @default(0.7)
  isDefault   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bots Bot[]

  @@map("ai_configs")
}

model Bot {
  id           String          @id @default(uuid())
  userId       String
  name         String
  initialMessage String?       @db.Text
  responseMode BotResponseMode @default(KEYWORDS)
  isActive     Boolean         @default(true)
  systemPrompt String?         @db.Text // Prompt de sistema para IA
  aiConfigId   String?
  flowConfig   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiConfig          AiConfig?         @relation(fields: [aiConfigId], references: [id], onDelete: SetNull)
  whatsappChannel   WhatsappChannel?
  keywords          Keyword[]
  conversations     Conversation[]
  menus             InteractiveMenu[]
  contacts          Contact[]
  scheduledMessages ScheduledMessage[]
  broadcastLists    BroadcastList[]
  broadcasts        Broadcast[]
  leads             Lead[]
  iterations        BotIteration[]

  @@map("bots")
}

model InteractiveMenu {
  id              String   @id @default(uuid())
  botId           String
  trigger         String   // Keyword or command that activates this menu
  title           String   // Menu title/header
  body            String?  @db.Text // Menu body text
  footer          String?  // Menu footer text
  options         Json     // Array of { id: string, title: string, description?: string }
  captureVariable Json?    // { name: string, type: VariableType, promptMessage: string } - captura de variável
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, trigger])
  @@map("interactive_menus")
}

model WhatsappChannel {
  id              String          @id @default(uuid())
  botId           String          @unique
  phoneNumber     String          @unique
  provider        ChannelProvider @default(DIALOG360)
  dialog360ApiKey String?
  // Evolution API fields
  evolutionApiUrl    String?      // URL da instância Evolution (ex: https://api.evolution.com)
  evolutionApiKey    String?      // Global API Key da Evolution
  evolutionInstance  String?      // Nome da instância na Evolution
  // Baileys direct fields
  baileysApiUrl   String?         // URL do servidor Baileys HTTP (ex: http://localhost:3001)
  baileysApiKey   String?         // API key do servidor Baileys
  baileysInstance String?         // Nome da sessão/instância Baileys
  webhookSecret   String?
  isVerified      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("whatsapp_channels")
}

model Keyword {
  id              String   @id @default(uuid())
  botId           String
  trigger         String   // Palavra/frase que ativa a resposta
  response        String   @db.Text // Resposta fixa
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  goto            Json?    // { type: 'MENU' | 'KEYWORD', target: string } - navegação após resposta
  captureVariable Json?    // { name: string, type: VariableType, promptMessage: string } - captura de variável
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, trigger])
  @@map("keywords")
}

model Conversation {
  id                    String   @id @default(uuid())
  botId                 String
  contactPhone          String
  contactName           String?
  isActive              Boolean  @default(true)
  status                ConversationStatus @default(BOT)
  humanTakeoverAt       DateTime?
  lastMessageAt         DateTime @default(now())
  flowStepIndex         Int      @default(0)
  waitingForVariable    Boolean  @default(false)
  pendingVariableName   String?
  pendingVariableType   VariableType?
  pendingVariableGoto   Json?    // goto a executar após captura da variável
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bot       Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages  Message[]
  variables ConversationVariable[]

  @@unique([botId, contactPhone])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationVariable {
  id             String       @id @default(uuid())
  conversationId String
  name           String
  type           VariableType
  value          String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, name])
  @@map("conversation_variables")
}

model Message {
  id              String           @id @default(uuid())
  conversationId  String
  direction       MessageDirection
  content         String           @db.Text
  status          MessageStatus    @default(SENT)
  senderType      MessageSender    @default(BOT)
  dialog360MsgId  String?
  externalMsgId   String?          // ID genérico da mensagem (Evolution ou outro provider)
  createdAt       DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Contact {
  id           String   @id @default(uuid())
  botId        String
  phone        String
  name         String?
  email        String?
  tags         String[] @default([])
  customFields Json?    // { key: value }
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bot               Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  scheduledMessages ScheduledMessage[]
  lead              Lead?

  @@unique([botId, phone])
  @@index([botId])
  @@map("contacts")
}

model ScheduledMessage {
  id           String                 @id @default(uuid())
  botId        String
  contactId    String?
  phone        String                 // Número de destino
  message      String                 @db.Text
  scheduledAt  DateTime
  status       ScheduledMessageStatus @default(PENDING)
  sentAt       DateTime?
  errorMessage String?                @db.Text
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  bot     Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([botId])
  @@map("scheduled_messages")
}

model BroadcastList {
  id        String   @id @default(uuid())
  botId     String
  name      String
  phones    String[] @default([]) // Lista de números
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot        Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([botId])
  @@map("broadcast_lists")
}

model Broadcast {
  id              String          @id @default(uuid())
  botId           String
  listId          String?
  name            String
  message         String          @db.Text
  phones          String[]        @default([]) // Snapshot dos números no envio
  status          BroadcastStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int             @default(0)
  successCount    Int             @default(0)
  failCount       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bot  Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  list BroadcastList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([botId])
  @@index([status, scheduledAt])
  @@map("broadcasts")
}

model Lead {
  id                 String          @id @default(uuid())
  botId              String
  contactId          String          @unique
  score              Int             @default(0)
  status             LeadStatus      @default(NEW)
  temperature        LeadTemperature @default(COLD)
  source             String?

  // Métricas cacheadas
  totalMessages      Int             @default(0)
  inboundMessages    Int             @default(0)
  outboundMessages   Int             @default(0)
  totalConversations Int             @default(0)
  lastInteractionAt  DateTime?
  firstInteractionAt DateTime?
  responseRate       Float           @default(0)
  avgResponseTime    Float           @default(0)
  humanTakeovers     Int             @default(0)

  // Campos de negócio
  estimatedValue     Float?
  notes              String?         @db.Text
  convertedAt        DateTime?
  lostReason         String?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bot     Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  history LeadHistory[]

  @@index([botId])
  @@index([botId, status])
  @@index([botId, temperature])
  @@index([score])
  @@map("leads")
}

model LeadHistory {
  id        String   @id @default(uuid())
  leadId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_history")
}

model BotIteration {
  id        String        @id @default(uuid())
  botId     String
  name      String        // Nome amigável da iteração
  type      IterationType // TEXT, LINK, DOCUMENT, GOTO, CAPTURE_VARIABLE
  content   Json          // Conteúdo específico por tipo
  order     Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([botId, order])
  @@map("bot_iterations")
}
